    "/api/refresh": {
      "post": {
        "summary": "Refresh",
        "operationId": "refresh_api_refresh_post",
        "parameters": [
          {
            "name": "offline",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Use packaged fixtures and do not call external APIs.",
              "default": false,
              "title": "Offline"
            },
            "description": "Use packaged fixtures and do not call external APIs."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
