          },
          "objectives": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Objectives"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "title": "Evidence"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/PolicyOption"
            },
            "type": "array",
            "title": "Options"
          },
          "policy_bundles": {
            "items": {
              "$ref": "#/components/schemas/PolicyBundle"
            },
            "type": "array",
            "title": "Policy Bundles"
          },
          "risks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Risks"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "data_mode": {
            "type": "string",
            "enum": [
              "live",
              "fixture",
              "mixed",
              "unknown"
            ],
            "title": "Data Mode",
            "default": "unknown"
          },
          "data_notice": {
            "type": "string",
            "title": "Data Notice",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "summary"
        ],
        "title": "AdviceResponse"
      },
      "Citation": {
        "properties": {
          "citation_id": {
            "type": "string",
            "title": "Citation Id"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "retrieval_date": {
            "type": "string",
            "title": "Retrieval Date"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "geography": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
