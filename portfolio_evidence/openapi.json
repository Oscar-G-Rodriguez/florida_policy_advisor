          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "limited",
              "unavailable"
            ],
            "title": "Status",
            "default": "available"
          },
          "method_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method Note"
          },
          "evaluation_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluation Note"
          },
          "uncertainty": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uncertainty"
          },
          "validation_metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Validation Metrics"
          }
        },
        "type": "object",
        "required": [
          "metric_id",
          "sector",
          "metric",
          "horizon",
          "direction"
        ],
        "title": "ForecastItem"
      },
      "Geography": {
        "properties": {
          "level": {
            "type": "string",
