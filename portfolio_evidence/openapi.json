          },
          "value": {
            "type": "string",
            "title": "Value",
            "description": "State name or county FIPS/name"
          }
        },
        "type": "object",
        "required": [
          "level",
          "value"
        ],
        "title": "Geography"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoRequest": {
        "properties": {
          "inputs": {
            "$ref": "#/components/schemas/AdviceRequest"
          },
          "advice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AdviceResponse-Input"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "inputs"
        ],
        "title": "MemoRequest"
      },
      "MemoResponse": {
        "properties": {
          "memo_path": {
            "type": "string",
